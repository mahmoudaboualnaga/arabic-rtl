{
  "description": "Keeps Arabic right-to-left automatically: loads the Arabic writing rules at session start, offers to fix scrambled Arabic in reopened chats and in the working folder, and reminds Claude of the rules on every Arabic message.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\" 2>/dev/null || cat \"${CLAUDE_PLUGIN_ROOT}/hooks/arabic-rtl-context.md\" 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/arabic_prompt.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/arabic_prompt.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}